# Copy this file to .env and fill in the values.
# Everything below is read by the app; see README > Environment variables.

# ---- Required ----
# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign login tokens. REQUIRED, and must be at least 32 characters.
# There is no usable default on purpose: a shared secret in the repo is the same
# as having no auth at all. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# ---- First admin (used by POST /api/setup and npm run db:seed) ----
# Required for setup to run at all, and the password must not be a well-known
# demo value. Leave blank to skip admin creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Demo mode (development / staged demos only) ----
# Shows the demo accounts on the login page and seeds the demo customer.
# NEVER enable this on a public deployment.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
DEMO_CUSTOMER_EMAIL=demo@egghub.rw
DEMO_CUSTOMER_PASSWORD=

# ---- Payments ----
# mock = Mobile Money / Card orders are marked paid immediately (development only).
# real = orders stay pending until an operator confirms payment.
PAYMENT_MODE=mock
# Real payments (e.g. MTN MoMo). Not used yet.
PAYMENT_API_KEY=

# ---- Hosting ----
# Set to true when the app runs behind a reverse proxy / load balancer that sets
# x-forwarded-for. Without it, rate limiting uses the direct socket address.
TRUST_PROXY=false
# Set to true when your database requires TLS (most managed providers).
DATABASE_SSL=false

# ---- Optional / future ----
# Cloudinary (optional). Not used yet - images are stored locally in public/uploads,
# which is ephemeral on most hosts.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
