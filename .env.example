# Copy this file to .env and fill in the values

# PostgreSQL connection (local development)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# First admin account (used once by POST /api/setup)
ADMIN_EMAIL=admin@egghub.rw
ADMIN_PASSWORD=Admin1234

# ---- Optional / future ----
# Real payments (e.g. MTN MoMo). Not used yet - the app uses a mock payment flow.
PAYMENT_API_KEY=
# Cloudinary (optional). Not used yet - images are stored locally in public/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: keeps old login sessions working while you migrate. REMOVE for production.
JWT_SECRET_FALLBACK=
