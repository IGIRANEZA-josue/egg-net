# Copy this file to .env and fill in the values.
# For local development with `npm run db:local`, the defaults below work as-is.

# PostgreSQL connection string.
# Local (embedded dev database): postgresql://postgres:postgres@127.0.0.1:5433/app_db
# Production (e.g. Neon on Vercel): paste the pooled connection string from your provider.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/app_db

# Secret used to sign JWT login tokens. Use a long random string (32+ chars), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, a strong secret is generated once and stored in the database.
JWT_SECRET=

# First admin account, created once by POST /api/setup (or `npm run seed`).
# In production ADMIN_PASSWORD is REQUIRED (min 8 chars) — there is no default.
ADMIN_EMAIL=admin@egghub.rw
ADMIN_PASSWORD=

# Protects POST /api/setup. When set, callers must send header  x-setup-secret: <value>.
# Recommended in production. Generate like JWT_SECRET.
SETUP_SECRET=

# Set to "true" to create the demo customer (demo@egghub.rw / Demo1234) during setup
# and to show the one-click demo login buttons. Always on in development; keep OFF
# in production unless this is a throwaway demo deployment.
NEXT_PUBLIC_ENABLE_DEMO=false

# ---- Optional / future ----
# Real payments (e.g. MTN MoMo). Not used yet - the app uses a clearly-labelled mock flow.
PAYMENT_API_KEY=

# Optional: keeps old login sessions working after a JWT_SECRET rotation. REMOVE afterwards.
JWT_SECRET_FALLBACK=
